{
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "thirdeye", "region": "asia-south1" } },
      { "source": "/healthz", "run": { "serviceId": "thirdeye", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
