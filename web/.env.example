# Copy to .env.production (untracked) before `npm run build` for Firebase Hosting.
# Leave everything blank to build for a local server: same origin, no sign-in.

# The Cloud Run URL. Blank = the page's own origin (served by the FastAPI app).
VITE_API_URL=

# Firebase web app config (Project settings -> Your apps). These identify the
# project; they are not secrets. Blank = no sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
