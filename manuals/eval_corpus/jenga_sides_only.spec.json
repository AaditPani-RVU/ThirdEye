{
 "procedure": "jenga_sides_only",
 "kind": "constraints",
 "state_model": "tower_lattice",
 "tower": {
  "layers": 18,
  "slots_per_layer": 3
 },
 "actions": [
  {
   "id": "move",
   "instruction": "Take one block and place it on top",
   "preconditions": [
    {
     "id": "c1",
     "expr": "src.layer <= top_complete_layer - 1",
     "text": "Take only from below the top complete level",
     "violation": "illegal_source_layer",
     "on_violation": "alert"
    },
    {
     "id": "c2",
     "expr": "hands_in_contact == 1",
     "text": "One hand at a time",
     "violation": "two_handed_move",
     "on_violation": "alert"
    },
    {
     "id": "c3",
     "expr": "dst.layer == top_layer or layer_complete(top_layer)",
     "text": "Finish the top level before starting a new one",
     "violation": "layer_started_early",
     "on_violation": "alert"
    },
    {
     "id": "c4",
     "expr": "dst in legal_top_slots()",
     "text": "Place blocks only in an empty spot on top",
     "violation": "wrong_replacement",
     "on_violation": "alert"
    },
    {
     "id": "c5",
     "expr": "src.slot != 1",
     "text": "Only side blocks may be taken",
     "violation": "middle_block_taken",
     "on_violation": "alert"
    }
   ],
   "effects": [
    "occupancy[src] = 0",
    "occupancy[dst] = 1"
   ]
  }
 ],
 "terminal": [
  {
   "id": "t1",
   "expr": "collapse_detected",
   "outcome": "game_over"
  }
 ],
 "provenance": {
  "compiler_version": "ground-truth",
  "model": "hand",
  "source": "",
  "compiled_at": "",
  "repaired": false
 }
}
